# ── Database ──────────────────────────────────────────────────────────
# Railway's Postgres plugin sets this for you.
DATABASE_URL=postgres://postgres@localhost:5432/masterapp
# A managed Postgres (DigitalOcean) signs with its own CA: give it here so the
# connection is verified. On App Platform: ${your-db.CA_CERT}. Without it, a
# url with sslmode=require is encrypted but not verified.
# DATABASE_CA_CERT=

# ── The first admin (created once, only when there are no accounts) ─────
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=at-least-ten-characters
ADMIN_NAME=Hasnain

# ── Photos ────────────────────────────────────────────────────────────
# Cloudflare R2 (private bucket). With all four set, photos go to R2.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Otherwise they go to disk here — on Railway, the volume's mount path.
DATA_DIR=/data

# ── Chrono Key (read-only copy until the switch-over) ──────────────────
CHRONOKEY_USERNAME=
CHRONOKEY_PASSWORD=
# CHRONOKEY_URL=https://fobcheck.azurewebsites.net

# ── The Watch vault (puro-sync worker) ─────────────────────────────────
# The worker's WORKER_TOKEN — the same value as InvoiceWEB's VAULT_TOKEN.
VAULT_TOKEN=
# VAULT_URL=https://puro-sync.purosangue.workers.dev/api/state

# ── Sync ──────────────────────────────────────────────────────────────
# off = masterapp is the master; nothing is copied any more.
SYNC=on
SYNC_INTERVAL_MIN=15
SYNC_FULL_EVERY_HOURS=24
SYNC_CONCURRENCY=2
SYNC_PAUSE_MS=400

# ── The logistics app (the same worker document) ──────────────────────
# Its own switch; follows SYNC when not set. off = masterapp is the master
# for logistics. The worker's version stamp is checked every POLL_SEC seconds
# (0 = only the 15-minute pass); its pictures are copied 100 a pass.
# LOGISTICS_SYNC=on
# LOGISTICS_POLL_SEC=60
# LOGISTICS_PHOTOS_PER_PASS=100

# The logistics app itself (its Vercel address), for the Logistics tabs' "Watch Vault" link
# LOGISTICS_APP_URL=https://purosangue-watches.vercel.app

# masterapp's own Claude key for the logistics AI features (route optimizer, AI flights, instructions into a plan, market prices, Stock Take)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
