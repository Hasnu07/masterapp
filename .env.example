# ── Database ──────────────────────────────────────────────────────────
# Railway's Postgres plugin sets this for you.
DATABASE_URL=postgres://postgres@localhost:5432/masterapp
# A managed Postgres (DigitalOcean) signs with its own CA: give it here so the
# connection is verified. On App Platform: ${your-db.CA_CERT}. Without it, a
# url with sslmode=require is encrypted but not verified.
# DATABASE_CA_CERT=

# ── The first admin (created once, only when there are no accounts) ─────
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=at-least-ten-characters
ADMIN_NAME=Hasnain

# ── Photos ────────────────────────────────────────────────────────────
# Cloudflare R2 (private bucket). With all four set, photos go to R2.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Otherwise they go to disk here — on Railway, the volume's mount path.
DATA_DIR=/data

# ── Chrono Key (read-only copy until the switch-over) ──────────────────
CHRONOKEY_USERNAME=
CHRONOKEY_PASSWORD=
# CHRONOKEY_URL=https://fobcheck.azurewebsites.net

# ── The Watch vault (puro-sync worker) ─────────────────────────────────
# The worker's WORKER_TOKEN — the same value as InvoiceWEB's VAULT_TOKEN.
VAULT_TOKEN=
# VAULT_URL=https://puro-sync.purosangue.workers.dev/api/state

# ── Sync ──────────────────────────────────────────────────────────────
# off = masterapp is the master; nothing is copied any more.
SYNC=on
SYNC_INTERVAL_MIN=15
SYNC_FULL_EVERY_HOURS=24
SYNC_CONCURRENCY=2
SYNC_PAUSE_MS=400

# ── The logistics app (the same worker document) ──────────────────────
# Its own switch; follows SYNC when not set. off = masterapp is the master
# for logistics. The worker's version stamp is checked every POLL_SEC seconds
# (0 = only the 15-minute pass); its pictures are copied 100 a pass.
# Off by default since 30 Oct 2026 — Logistics in the ERP is the app itself (below). `on` copies again.
# LOGISTICS_SYNC=off
# LOGISTICS_POLL_SEC=60
# LOGISTICS_PHOTOS_PER_PASS=100

# The logistics app itself (its Vercel address): the ERP serves it at /lg-app/ as the Logistics menu, behind the
# sign-in. This is the default; `off` takes it out of the menu.
# LOGISTICS_APP_URL=https://purosangue-watches.vercel.app

# ── The accounts app (Purosangue Watches — Accounts, on Railway) ──────
# The ERP serves it at /acc-app/ as the Accounts menu, behind the sign-in; each
# person signs in to it once, inside the frame, with their own accounts account.
# `off` takes it out of the menu.
# ACCOUNTS_APP_URL=https://accountancy-app-production.up.railway.app
# The copy of its records into the ERP signs in as the ERP: make an account for
# it in the app (Admin → Team: approved, password set) and put it here. Without
# them nothing is copied. ACCOUNTS_SYNC=off is the switch-over for accounts
# (on by default); the version numbers are checked every POLL_SEC seconds.
ACCOUNTS_USERNAME=
ACCOUNTS_PASSWORD=
# ACCOUNTS_SYNC=on
# ACCOUNTS_POLL_SEC=60
# Its uploads (proofs, invoices) copied here this many a full pass, for the switch-over.
# ACCOUNTS_FILES_PER_PASS=200

# ── Claude in the ERP ─────────────────────────────────────────────────
# The watch's brief (top of its Timeline) and the Ask button, read-only, through
# the Claude API. Without the key the buttons are not shown.
ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5
# AI_EFFORT=medium
